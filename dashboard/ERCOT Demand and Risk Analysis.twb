      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0t6zlsc1clk5os1cc5xin18zl83z].[avg:Calculation_0727352929243148:qk]&quot;' value='High Demand' />
          <alias key='&quot;[federated.0t6zlsc1clk5os1cc5xin18zl83z].[avg:Calculation_0727352929386509:qk]&quot;' value='Extreme Demand' />
        </aliases>
      </column>
      <column caption='Count Periods' datatype='integer' name='[Calculation_0727352910434304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([period_utc_tableau])' />
      </column>
      <column caption='Count Distinct Periods' datatype='integer' name='[Calculation_0727352910536705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([period_utc_tableau])' />
      </column>
      <column caption='Min Period' datatype='datetime' name='[Calculation_0727352913756166]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MIN([period_utc_tableau])' />
      </column>
      <column caption='Max Period' datatype='datetime' name='[Calculation_0727352913817607]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([period_utc_tableau])' />
      </column>
      <column caption='Demand Risk Category' datatype='string' name='[Calculation_0727352926023689]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [extreme_demand_flag] THEN &apos;Extreme&apos;&#13;&#10;ELSEIF  [high_demand_flag] THEN &apos;High&apos;&#13;&#10;ELSE &apos;Normal&apos;&#13;&#10;END' />
      </column>
      <column caption='High Demand Hours' datatype='integer' name='[Calculation_0727352929243148]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0727352926023689] = &apos;High&apos; THEN 1 ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Extreme Demand Hours' datatype='integer' name='[Calculation_0727352929386509]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0727352926023689] = &apos;Extreme&apos; THEN 1 ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Total Elevated Risk Hours' datatype='real' name='[Calculation_0727352934006798]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_0727352929243148])+AVG([Calculation_0727352929386509])' />
      </column>
      <column caption='Temperature Mean (Bins)' datatype='integer' name='[Calculation_0727352960389136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOOR([temp_mean]/5)*5' />
      </column>
      <column caption='Selected Week Start' datatype='datetime' name='[Calculation_0727353010184209]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [period_utc_tableau])' />
      </column>
      <column caption='Selected Week Year' datatype='integer' name='[Calculation_0727353022844946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR(DATETRUNC(&apos;week&apos;, [period_utc_tableau]))' />
      </column>
      <column caption='Show Selected Demand Year' datatype='boolean' name='[Calculation_0727353024815123]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0727353022844946] = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Week Reporting Year' datatype='integer' name='[Calculation_0727353027538964]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR(&#13;&#10;    DATEADD(&#13;&#10;        &apos;day&apos;,&#13;&#10;        3,&#13;&#10;        DATETRUNC(&apos;week&apos;, [period_utc_tableau])&#13;&#10;    )&#13;&#10;)' />
      </column>
      <column aggregation='None' caption='Temp Mean (bin)' datatype='integer' name='[Temp Mean (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[temp_mean]' peg='0' size='5' />
      </column>
